# Authentik container image and release tag.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.5.6

# Host ports published by the compose stack.
COMPOSE_PORT_HTTP=9001
COMPOSE_PORT_HTTPS=9443

# PostgreSQL database settings used by the bundled database container.
PG_DB=authentik
PG_USER=authentik
PG_PASS=REPLACE_WITH_OPENSSL_BASE64_36

# Authentik secret key used for signing cookies, tokens, and internal data.
AUTHENTIK_SECRET_KEY=REPLACE_WITH_OPENSSL_BASE64_60

# Optional error reporting to the Authentik team.
AUTHENTIK_ERROR_REPORTING__ENABLED=true

# SMTP server configuration. Leave the auth fields empty if your relay does not require credentials.
AUTHENTIK_EMAIL__HOST=smtp.example.com
AUTHENTIK_EMAIL__PORT=587
# Optionally authenticate (don't add quotation marks to your password)
AUTHENTIK_EMAIL__USERNAME=authentik@example.com
AUTHENTIK_EMAIL__PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# STARTTLS / explicit TLS, usually on port 587
AUTHENTIK_EMAIL__USE_TLS=true
# Implicit TLS/SSL on the SMTP connection (`USE_SSL` is the variable name), usually on port 465
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
# Sender email address; verify that the domain is valid.
AUTHENTIK_EMAIL__FROM=authentik@example.com

# Reverse proxy settings for the external nginx-proxy stack.
VIRTUAL_HOST=authentik.example.com
VIRTUAL_PORT=9000
LETSENCRYPT_HOST=authentik.example.com

# Container runtime socket path.
# Docker: /var/run/docker.sock
# Podman (rootful): /run/podman/podman.sock
# Podman (rootless): /run/user/1000/podman/podman.sock
CONTAINER_SOCKET=/var/run/docker.sock
