# ACME challenge type (default: DNS-01)
# See https://github.com/nginx-proxy/acme-companion/blob/main/docs/Advanced-usage.md
ACME_CHALLENGE=DNS-01

# acme.sh DNS API plugin (default: dns_cf for Cloudflare)
# See https://github.com/nginx-proxy/acme-companion/blob/main/docs/Let's-Encrypt-and-ACME.md#dns-01-acme-challenge
# See https://github.com/acmesh-official/acme.sh/wiki/dnsapi for all DNS API options
ACMESH_DNS_API=dns_cf

# Cloudflare API Token (dns_cf)
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone - DNS - Edit
CF_TOKEN=your-cloudflare-dns-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_ZONE_ID=

# IPv6 support
# See https://github.com/nginx-proxy/nginx-proxy/tree/main/docs#ipv6-support
ENABLE_IPV6=false
PREFER_IPV6_NETWORK=false

# Ports
HTTP_PORT=80
HTTPS_PORT=443

# Bind address (use 0.0.0.0 for all interfaces)
BIND_ADDRESS=0.0.0.0

# PROXY protocol support (default: disabled)
# On macOS with Podman Desktop, gvproxy NATs all traffic to 192.168.127.1,
# losing the real client IP. To preserve it, run HAProxy on the host with
# PROXY protocol. See docs/podman-macos-real-ip.md for setup instructions.
# Uncomment the following lines to enable:
#   BIND_ADDRESS=127.0.0.1
#   HTTP_PORT=8080
#   HTTPS_PORT=8443
#   ENABLE_PROXY_PROTOCOL=true
ENABLE_PROXY_PROTOCOL=false

# Container runtime socket path
# Docker: /var/run/docker.sock
# Podman (rootful): /run/podman/podman.sock
# Podman (rootless): /run/user/1000/podman/podman.sock
CONTAINER_SOCKET=/var/run/docker.sock
